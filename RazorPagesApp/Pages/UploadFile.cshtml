@page
@model RazorPagesApp.Pages.UploadFileModel
@{
    ViewData["Title"] = "Додавання файлу";
}

<div class="page-wrapper">
    <div class="content-wrapper">

        <!-- хедер -->
        <div class="header-section">
            <div class="icon-blob">
                <i class="bi bi-cloud-arrow-up"></i>
            </div>
            <h1 class="main-title">Завантаження файлів</h1>
            <p class="subtitle">Перетягніть файл або натисніть кнопку нижче</p>
        </div>

        <!-- аплоад зона -->
        <div class="upload-card">
            <form method="post" enctype="multipart/form-data" id="uploadForm">
                <div class="dropzone" id="dropzone">
                    <input type="file"
                           name="UploadedFile"
                           id="fileInput"
                           accept="*/*" />

                    <div class="dz-message" id="dzMessage">
                        <div class="upload-icon-wrapper">
                            <i class="bi bi-cloud-upload upload-icon"></i>
                            <div class="icon-rings"></div>
                        </div>
                        <p class="upload-text">
                            Перетягніть файл сюди або
                        </p>
                        <label for="fileInput" class="select-btn">
                            <i class="bi bi-folder2-open me-2"></i>
                            Оберіть файл
                        </label>
                    </div>

                    <div id="filePreview" class="file-preview d-none">
                        <div class="file-icon">
                            <i class="bi bi-file-earmark-check"></i>
                        </div>
                        <div class="file-info">
                            <p class="file-name" id="selectedFileName"></p>
                            <p class="file-size" id="selectedFileSize"></p>
                        </div>
                        <button type="button" class="remove-file" id="removeFile">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="upload-btn" id="uploadBtn">
                    <span class="btn-content">
                        <i class="bi bi-upload me-2"></i>
                        Завантажити на сервер
                    </span>
                    <div class="btn-glow"></div>
                </button>
            </form>
        </div>

        <!-- список файлів -->
        <div class="files-section">
            <div class="section-header">
                <h2 class="section-title">
                    <i class="bi bi-folder-check me-2"></i>
                    Завантажені файли
                </h2>
                @if (Model.Files != null && Model.Files.Any())
                {
                    <span class="file-count">@Model.Files.Count() файлів</span>
                }
            </div>

            @if (Model.Files != null && Model.Files.Any())
            {
                <div class="files-grid">
                    @foreach (var file in Model.Files)
                    {
                        <div class="file-card">
                            <div class="file-thumbnail">
                                <img src="@Url.Content(file.Path)"
                                     alt="@file.Name"
                                     onerror="this.parentElement.innerHTML='<div class=\'placeholder-icon\'><i class=\'bi bi-file-earmark\'></i></div>'" />
                            </div>
                            <div class="file-details">
                                <p class="file-title" title="@file.Name">@file.Name</p>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <div class="empty-icon">
                        <i class="bi bi-inbox"></i>
                    </div>
                    <p class="empty-text">Поки що немає завантажених файлів</p>
                    <p class="empty-subtext">Завантажте перший файл, щоб побачити його тут</p>
                </div>
            }
        </div>

    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    :root {
        --primary: #6366f1;
        --primary-dark: #4f46e5;
        --primary-light: #818cf8;
        --secondary: #ec4899;
        --success: #10b981;
        --background: #0f172a;
        --surface: #1e293b;
        --surface-light: #334155;
        --text: #f1f5f9;
        --text-muted: #94a3b8;
        --border: #334155;
    }

    body {
        background: var(--background);
        color: var(--text);
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
        min-height: 100vh;
    }

    .page-wrapper {
        background: linear-gradient(135deg, #1e1b4b 0%, #312e81 50%, #1e1b4b 100%);
        min-height: 100vh;
        padding: 10rem 0 4rem;
        position: relative;
        overflow: hidden;
    }

        .page-wrapper::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(99, 102, 241, 0.1) 1px, transparent 1px);
            background-size: 50px 50px;
            animation: moveGrid 20s linear infinite;
        }

    @@keyframes moveGrid {
        0% {
            transform: translate(0, 0);
        }

        100% {
            transform: translate(50px, 50px);
        }
    }

    .container {
        position: relative;
        z-index: 1;
        max-width: 100%;
        padding: 0;
    }

    .header-section {
        text-align: center;
        margin-bottom: 3rem;
    }

    .icon-blob {
        width: 100px;
        height: 100px;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 2rem;
        position: relative;
        animation: float 3s ease-in-out infinite;
    }

        .icon-blob::before,
        .icon-blob::after {
            content: '';
            position: absolute;
            border-radius: 50%;
            border: 2px solid var(--primary);
            animation: pulse 2s ease-out infinite;
        }

        .icon-blob::before {
            width: 120%;
            height: 120%;
            opacity: 0.3;
        }

        .icon-blob::after {
            width: 140%;
            height: 140%;
            opacity: 0.2;
            animation-delay: 1s;
        }

        .icon-blob i {
            font-size: 3rem;
            color: white;
        }

    @@keyframes float {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-10px);
        }
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
            opacity: 0.3;
        }

        100% {
            transform: scale(1.3);
            opacity: 0;
        }
    }

    .main-title {
        font-size: 3rem;
        font-weight: 800;
        background: linear-gradient(135deg, #fff 0%, var(--primary-light) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 1rem;
        letter-spacing: -1px;
    }

    .subtitle {
        font-size: 1.25rem;
        color: var(--text-muted);
        font-weight: 300;
    }

    .upload-card {
        background: rgba(30, 41, 59, 0.6);
        backdrop-filter: blur(20px);
        border: 1px solid var(--border);
        border-radius: 24px;
        padding: 3rem;
        margin-bottom: 4rem;
        box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    }

    .dropzone {
        border: 3px dashed var(--border);
        border-radius: 20px;
        padding: 4rem 2rem;
        text-align: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
        background: rgba(15, 23, 42, 0.3);
        cursor: pointer;
    }

        .dropzone:hover {
            border-color: var(--primary);
            background: rgba(99, 102, 241, 0.05);
            transform: scale(1.01);
        }

        .dropzone.drag-over {
            border-color: var(--primary-light);
            background: rgba(99, 102, 241, 0.1);
            transform: scale(1.02);
        }

    #fileInput {
        display: none;
    }

    .upload-icon-wrapper {
        position: relative;
        display: inline-block;
        margin-bottom: 1.5rem;
    }

    .upload-icon {
        font-size: 5rem;
        color: var(--primary);
        animation: bounce 2s ease-in-out infinite;
    }

    .icon-rings {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 120px;
        height: 120px;
        transform: translate(-50%, -50%);
        border-radius: 50%;
        border: 2px solid var(--primary);
        opacity: 0;
        animation: ringPulse 2s ease-out infinite;
    }

    @@keyframes bounce {
        0%, 100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-15px);
        }
    }

    @@keyframes ringPulse {
        0% {
            transform: translate(-50%, -50%) scale(0.8);
            opacity: 0.5;
        }

        100% {
            transform: translate(-50%, -50%) scale(1.5);
            opacity: 0;
        }
    }

    .upload-text {
        font-size: 1.5rem;
        color: var(--text);
        margin-bottom: 1.5rem;
        font-weight: 500;
    }

    .select-btn {
        display: inline-block;
        background: linear-gradient(135deg, var(--primary), var(--primary-dark));
        color: white;
        padding: 1rem 3rem;
        border-radius: 12px;
        font-size: 1.125rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        border: none;
        box-shadow: 0 10px 30px rgba(99, 102, 241, 0.3);
    }

        .select-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 40px rgba(99, 102, 241, 0.4);
        }

    .file-preview {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        padding: 2rem;
        background: rgba(99, 102, 241, 0.1);
        border: 2px solid var(--primary);
        border-radius: 16px;
        animation: slideIn 0.3s ease-out;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(-10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .file-icon {
        font-size: 3rem;
        color: var(--success);
    }

    .file-info {
        flex: 1;
        text-align: left;
    }

    .file-name {
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 0.25rem;
        word-break: break-word;
    }

    .file-size {
        font-size: 0.875rem;
        color: var(--text-muted);
        margin: 0;
    }

    .remove-file {
        background: rgba(239, 68, 68, 0.2);
        border: none;
        width: 40px;
        height: 40px;
        border-radius: 50%;
        color: #ef4444;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .remove-file:hover {
            background: #ef4444;
            color: white;
            transform: scale(1.1);
        }

    .upload-btn {
        width: 100%;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        color: white;
        border: none;
        padding: 1.25rem 2rem;
        border-radius: 12px;
        font-size: 1.25rem;
        font-weight: 700;
        margin-top: 2rem;
        cursor: pointer;
        position: relative;
        overflow: hidden;
        transition: all 0.3s;
    }

        .upload-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 20px 50px rgba(99, 102, 241, 0.4);
        }

        .upload-btn:active {
            transform: translateY(-1px);
        }

    .btn-content {
        position: relative;
        z-index: 1;
    }

    .btn-glow {
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.3) 0%, transparent 70%);
        transform: scale(0);
        transition: transform 0.6s;
    }

    .upload-btn:hover .btn-glow {
        transform: scale(1);
    }

    .files-section {
        margin-top: 4rem;
    }

    .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2rem;
    }

    .section-title {
        font-size: 2rem;
        font-weight: 700;
        color: var(--text);
        margin: 0;
    }

    .file-count {
        background: rgba(99, 102, 241, 0.2);
        color: var(--primary-light);
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-size: 0.875rem;
        font-weight: 600;
    }

    .files-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
        gap: 1.5rem;
    }

    .file-card {
        background: rgba(30, 41, 59, 0.6);
        backdrop-filter: blur(10px);
        border: 1px solid var(--border);
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        cursor: pointer;
    }

        .file-card:hover {
            transform: translateY(-8px);
            border-color: var(--primary);
            box-shadow: 0 20px 40px rgba(99, 102, 241, 0.3);
        }

    .file-thumbnail {
        height: 200px;
        background: rgba(15, 23, 42, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

        .file-thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.3s;
        }

    .file-card:hover .file-thumbnail img {
        transform: scale(1.1);
    }

    .placeholder-icon {
        font-size: 4rem;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
    }

    .file-details {
        padding: 1.25rem;
    }

    .file-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text);
        margin: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .empty-state {
        text-align: center;
        padding: 5rem 2rem;
        background: rgba(30, 41, 59, 0.4);
        border-radius: 20px;
        border: 2px dashed var(--border);
    }

    .empty-icon {
        font-size: 6rem;
        color: var(--text-muted);
        margin-bottom: 1.5rem;
        opacity: 0.5;
    }

    .empty-text {
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 0.5rem;
    }

    .empty-subtext {
        font-size: 1rem;
        color: var(--text-muted);
    }

    @@media (max-width: 768px) {
        .main-title {
            font-size: 2rem;
        }

        .upload-card {
            padding: 2rem 1.5rem;
        }

        .dropzone {
            padding: 3rem 1rem;
        }

        .files-grid {
            grid-template-columns: 1fr;
        }

        .section-header {
            flex-direction: column;
            gap: 1rem;
            align-items: flex-start;
        }
    }

    .page-wrapper .container {
        max-width: 100% !important;
        padding: 0 !important;
        margin: 0 auto !important;
        width: 100%;
    }

    .page-wrapper .row {
        margin: 0 !important;
        justify-content: center;
    }

    .page-wrapper [class*="col-"] {
        padding: 0 !important;
    }

    .header-section,
    .upload-card,
    .files-section {
        max-width: 1200px; 
        margin-left: auto;
        margin-right: auto;
        padding-left: 2rem;
        padding-right: 2rem;
    }

    .header-section {
        text-align: center;
    }

    @@media (max-width: 768px) {
        .header-section,
        .upload-card,
        .files-section {
            padding-left: 1rem;
            padding-right: 1rem;
        }
    }

    .content-wrapper {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 2rem;
        position: relative;
        z-index: 1;
    }

    .page-wrapper .container {
        display: none;
    }

    @@media (max-width: 768px) {
        .content-wrapper {
            padding: 0 1rem;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const dropzone = document.getElementById('dropzone');
        const fileInput = document.getElementById('fileInput');
        const dzMessage = document.getElementById('dzMessage');
        const filePreview = document.getElementById('filePreview');
        const selectedFileName = document.getElementById('selectedFileName');
        const selectedFileSize = document.getElementById('selectedFileSize');
        const removeFile = document.getElementById('removeFile');

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
        }

        function showFilePreview(file) {
            selectedFileName.textContent = file.name;
            selectedFileSize.textContent = formatFileSize(file.size);
            dzMessage.classList.add('d-none');
            filePreview.classList.remove('d-none');
        }

        function hideFilePreview() {
            dzMessage.classList.remove('d-none');
            filePreview.classList.add('d-none');
            fileInput.value = '';
        }

        fileInput.addEventListener('change', function(e) {
            if (this.files && this.files[0]) {
                showFilePreview(this.files[0]);
            }
        });

        if (removeFile) {
            removeFile.addEventListener('click', function(e) {
                e.stopPropagation();
                hideFilePreview();
            });
        }

        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropzone.addEventListener(eventName, preventDefaults, false);
        });

        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }

        ['dragenter', 'dragover'].forEach(eventName => {
            dropzone.addEventListener(eventName, function() {
                dropzone.classList.add('drag-over');
            }, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropzone.addEventListener(eventName, function() {
                dropzone.classList.remove('drag-over');
            }, false);
        });

        dropzone.addEventListener('drop', function(e) {
            const dt = e.dataTransfer;
            const files = dt.files;

            if (files.length > 0) {
                fileInput.files = files;
                showFilePreview(files[0]);
            }
        });
    });
</script>